modules = ["python-3.11", "go-1.25", "nodejs-24"]

run = "export PATH=\"/home/runner/go/bin:$PATH\" && cd thesis-agent && PYTHONPATH=. uvicorn thesis.web.app:app --host 0.0.0.0 --port 5000"
entrypoint = "thesis-agent/thesis/web/app.py"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
run = ["sh", "-c", "export PATH=\"/home/runner/go/bin:$PATH\" && cd thesis-agent && PYTHONPATH=. uvicorn thesis.web.app:app --host 0.0.0.0 --port 5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PATH=\"/home/runner/go/bin:$PATH\" && cd thesis-agent && PYTHONPATH=. uvicorn thesis.web.app:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[postMerge]
path = "thesis-agent/scripts/post_merge_setup.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]
